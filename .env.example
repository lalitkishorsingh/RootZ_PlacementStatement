APP_ENV=production
DJANGO_SECRET_KEY=generate-a-long-random-secret
DATA_KEYS=v1:generate-a-fernet-key
AUDIT_KEY=generate-an-independent-long-random-secret
LOOKUP_KEY=generate-an-independent-long-random-secret
BACKUP_KEY=generate-an-independent-fernet-key
ALLOWED_HOSTS=placement.example.edu
CSRF_TRUSTED_ORIGINS=https://placement.example.edu
SITE_URL=https://placement.example.edu
DB_NAME=placement
DB_USER=placement_app
DB_PASSWORD=generate-runtime-password
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/postgres-tls/ca.crt
POSTGRES_TLS_DIR=/absolute/path/to/protected/postgres-tls
DB_OWNER_PASSWORD=generate-migration-owner-password
PUBLIC_HOST=placement.example.edu
TRUST_PROXY=1
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_HOST_USER=placement@example.edu
EMAIL_HOST_PASSWORD=configure-smtp-secret
DEFAULT_FROM_EMAIL=placement@example.edu
RETENTION_DAYS=0
